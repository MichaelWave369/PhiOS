{
  "name": "phios-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "status": "node scripts/generate-status.mjs",
    "build": "node scripts/generate-status.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "test:rollout": "node --test tests/unit/*.test.mjs",
    "test:production": "playwright test --config=playwright.production.config.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "@playwright/test": "1.64.1"
  }
}
