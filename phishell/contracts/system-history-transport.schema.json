{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phios.system-history-transport.v0.12",
  "title": "PhiOS Governed Persistent History Read Transport",
  "type": "object",
  "required": [
    "transportSchemaVersion",
    "transport",
    "transportIdentity",
    "localOnly",
    "readOnly",
    "operationalAuthority",
    "actionAuthority",
    "executionAuthority",
    "effectPerformed",
    "servedAt",
    "projection"
  ],
  "properties": {
    "transportSchemaVersion": { "const": "phios.system-history-transport.v0.12" },
    "transport": { "const": "loopback-http" },
    "transportIdentity": { "const": "phios-governed-history-reader" },
    "localOnly": { "const": true },
    "readOnly": { "const": true },
    "operationalAuthority": { "const": false },
    "actionAuthority": { "const": false },
    "executionAuthority": { "const": false },
    "effectPerformed": { "const": false },
    "servedAt": { "type": "string", "format": "date-time" },
    "projection": { "$ref": "phios.system-history-projection.v0.12" }
  },
  "additionalProperties": false
}
