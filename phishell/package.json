{
  "name": "phishell",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src && node --test host/*.test.mjs",
    "probe:linux": "node host/linuxProbe.mjs",
    "local": "npm run build && node host/localTransport.mjs",
    "transport:check": "node host/localTransportBuiltCheck.mjs",
    "probe:services": "node host/serviceObserver.mjs",
    "probe:processes": "node host/processObserver.mjs",
    "probe:packages": "node host/packageObserver.mjs",
    "probe:devices": "node host/deviceObserver.mjs",
    "probe:state": "node host/systemStateComposer.mjs",
    "probe:changes": "node host/systemChangeDeriver.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@jellybrick/dbus-next": "0.11.3"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
