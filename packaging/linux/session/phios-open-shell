#!/usr/bin/env bash
set -euo pipefail
if [[ $EUID -eq 0 ]]; then
    echo 'Refusing to run the PhiShell browser as root.' >&2
    exit 1
fi
for attempt in {1..60}; do
    if /usr/bin/node -e 'fetch("http://127.0.0.1:3969/api/v1/health").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'; then
        exec chromium --ozone-platform=wayland --app=http://127.0.0.1:3969/ --no-first-run --disable-sync --disable-background-networking
    fi
    sleep 1
done
echo 'PhiShell transport did not become healthy; see journalctl --user -u phios-observer.' >&2
exit 1
